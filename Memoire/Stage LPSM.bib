@article{BCZ24,
  title = {Hairer's Multilevel {{Schauder}} Estimates without {{Regularity Structures}}},
  author = {Broux, Lucas and Caravenna, Francesco and Zambotti, Lorenzo},
  date = {2024-08-09},
  journaltitle = {Transactions of the American Mathematical Society},
  shortjournal = {Trans. Amer. Math. Soc.},
  eprint = {2301.07517},
  eprinttype = {arXiv},
  eprintclass = {math.AP},
  issn = {0002-9947, 1088-6850},
  doi = {10.1090/tran/9245},
  url = {http://arxiv.org/abs/2301.07517},
  urldate = {2026-06-16},
  abstract = {We investigate the regularising properties of singular kernels at the level of germs, i.e. families of distributions indexed by points in \$\textbackslash mathbb\{R\}\textasciicircum d\$. First we construct a suitable integration map which acts on general coherent germs. Then we focus on germs that can be decomposed along a basis (corresponding to the so-called modelled distributions in Regularity Structures) and we prove a version of Hairer's multilevel Schauder estimates in this setting, with minimal assumptions.},
  keywords = {Mathematics - Analysis of PDEs,Mathematics - Probability},
  file = {/Users/gdeboisgrollier/Zotero/storage/G5FY5R4D/Broux et al. - 2024 - Hairer's multilevel Schauder estimates without Regularity Structures.pdf;/Users/gdeboisgrollier/Zotero/storage/7CD8T8DB/2301.html}
}

