
@article{bruned_diagram-free_2024,
	title = {Diagram-free approach for convergence of trees based model in regularity structures},
	volume = {76},
	issn = {0025-5645, 1881-1167},
	url = {https://projecteuclid.org/journals/journal-of-the-mathematical-society-of-japan/volume-76/issue-4/Diagram-free-approach-for-convergence-of-trees-based-model-in/10.2969/jmsj/91129112.full},
	doi = {10.2969/jmsj/91129112},
	abstract = {In this work, we translate at the level of decorated trees some of the crucial arguments which have been used by P. Linares et al. in their recent paper to propose a diagram-free approach for the convergence of the model in regularity structures. This allows us to broaden the perspective and enlarge the scope of singular SPDEs covered by this approach. It also sheds new light on algebraic structures introduced in the foundational paper of M. Hairer on regularity structures which was used later for recursively described renormalised models.},
	language = {en},
	number = {4},
	urldate = {2026-06-11},
	journal = {Journal of the Mathematical Society of Japan},
	publisher = {Mathematical Society of Japan},
	author = {Bruned, Yvain and Nadeem, Usama},
	month = oct,
	year = {2024},
	keywords = {16T05, 60H15, decorated trees, diagram-free approach, Regularity structures, renormalisation, singular stochastic partial differential equations (SPDEs), spectral gap inequality},
	pages = {1139--1169},
	file = {Full Text PDF:/Users/gdeboisgrollier/Zotero/storage/2CIKNLE6/Bruned et Nadeem - 2024 - Diagram-free approach for convergence of trees based model in regularity structures.pdf:application/pdf},
}

@article{linares_diagram-free_2024,
	title = {A diagram-free approach to the stochastic estimates in regularity structures},
	volume = {237},
	issn = {0020-9910, 1432-1297},
	url = {http://arxiv.org/abs/2112.10739},
	doi = {10.1007/s00222-024-01275-z},
	abstract = {In this paper, we explore the version of Hairer's regularity structures based on a greedier index set than trees, as introduced by Otto, Sauer, Smith and Weber. More precisely, we construct and stochastically estimate the renormalized model avoiding the use of Feynman diagrams but still in a fully automated, i. e. inductive way. This is carried out for a class of quasi-linear parabolic PDEs driven by noise in the full singular but renormalizable range. We assume a spectral gap inequality on the (not necessarily Gaussian) noise ensemble. The resulting control on the variance of the model naturally complements its vanishing expectation arising from the BPHZ-choice of renormalization. We capture the gain in regularity on the level of the Malliavin derivative of the model by describing it as a modelled distribution. Symmetry is an important guiding principle and built-in on the level of the renormalization Ansatz. Our approach is analytic and top-down rather than combinatorial and bottom-up.},
	number = {3},
	urldate = {2026-06-15},
	journal = {Inventiones mathematicae},
	author = {Linares, Pablo and Otto, Felix and Tempelmayr, Markus and Tsatsoulis, Pavlos},
	month = sep,
	year = {2024},
	note = {arXiv:2112.10739 [math.PR]},
	keywords = {Mathematics - Analysis of PDEs, Mathematics - Probability},
	pages = {1469--1565},
	annote = {Comment: 76 pages, 5 figures. Changes in the 3rd version: more details on the logical order of the induction, updated bibliographical context},
	file = {Full Text PDF:/Users/gdeboisgrollier/Zotero/storage/IP524DQQ/Linares et al. - 2024 - A diagram-free approach to the stochastic estimates in regularity structures.pdf:application/pdf;Snapshot:/Users/gdeboisgrollier/Zotero/storage/793MYJTF/2112.html:text/html},
}

